NEXTJS_ENV=development
# CLI migration connection (owner/admin direct URL), separate from the app role.
DATABASE_URL=
GEO_MIGRATION_ACTOR=local-migration-admin
# Local login requires a random secret (at least 32 characters) and geo_app URL.
# Use the same values for dev:login and the running Next development server.
GEO_SESSION_SECRET=
GEO_APPLICATION_DATABASE_URL=
GEO_PUBLIC_ROOT_CATALOG=[]
# Trusted, tenant-bound written authorization + reviewed redaction dictionary.
# Keep real contacts/addresses in a secret binding; never commit its contents.
GEO_C_IMPORT_AUTHORIZATIONS=[]
# T10 stays disabled until the product owner freezes the reviewed rule digest.
GEO_WEEKLY_POLICY_RECORD=null
# Trusted public numeric receipts only, never tenant CSV or C-class original text.
GEO_INDUSTRY_POPULATIONS=[]
