{
  "name": "oak-geo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "dev:worker": "wrangler dev",
    "preview": "npm run build:worker && npm run dev:worker",
    "deploy": "opennextjs-cloudflare deploy",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:checks && npm run test:product",
    "doctor": "astryx doctor --built .next && astryx doctor --built .",
    "test:checks": "node --test --test-isolation=none tests/rules/*.test.mjs tests/arch/*.test.mjs tests/db/*.test.mjs",
    "test:product": "node --test --test-isolation=none tests/rules/product-hard-rules.red.mjs tests/arch/server-permissions.red.mjs",
    "test:db": "node --test --test-isolation=none tests/db/*.test.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:fixture": "node scripts/load-fixture.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.11",
    "@opennextjs/cloudflare": "1.20.16",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.11",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "18.6.0-beta.19",
    "typescript": "7.0.2",
    "wrangler": "4.158.0"
  }
}
